# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Selected Ollama model name (e.g., gemma:2b, gemma2:2b, or llama3.2:latest)
OLLAMA_MODEL=gemma:2b

# Request timeout in seconds for local model inference
OLLAMA_TIMEOUT_SECONDS=60

# Comma-separated list of approved absolute directory paths that TidyMind is permitted to scan/organize.
# For security, paths outside these approved roots are strictly rejected.
# Configure this with your local workspace path, e.g.:
APPROVED_DIRECTORIES=/path/to/tidymind-ai/sample_organizer_workspace,/path/to/tidymind-ai/docs
